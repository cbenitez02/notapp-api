# Email Security Configuration

# Dominio de email permitidos (separados por comas, vacío = todos permitidos)
ALLOWED_EMAIL_DOMAINS=

# Habilitar validación de dominio
ENABLE_DOMAIN_VALIDATION=false

# Límites de rate limiting para emails
EMAIL_RATE_LIMIT_WINDOW_MS=900000
EMAIL_RATE_LIMIT_MAX_REQUESTS=5
EMAIL_RESEND_RATE_LIMIT_MAX_REQUESTS=3

# Límites de cuota diaria
MAX_DAILY_EMAILS_PER_USER=50
MAX_DAILY_VERIFICATION_EMAILS=10
MAX_DAILY_PASSWORD_RESET_EMAILS=3
MAX_DAILY_RESEND_EMAILS=5

# Configuración SendGrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourapp.com
SENDGRID_FROM_NAME=NotApp

# Configuración de logging
ENABLE_EMAIL_AUDIT_LOGGING=true
EMAIL_LOG_LEVEL=info

# Configuración de seguridad adicional
BLOCK_DISPOSABLE_EMAIL_DOMAINS=true
ENABLE_SUSPICIOUS_PATTERN_DETECTION=true
MAX_EMAIL_CONTENT_LENGTH=100000
MAX_EMAIL_SUBJECT_LENGTH=200

# Configuración para desarrollo
NODE_ENV=development